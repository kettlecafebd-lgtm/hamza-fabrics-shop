# Local API (the Vite development fallback is also http://localhost:5000)
VITE_API_URL=http://localhost:5000

# Optional. Set this only while the API returns bare R2 object keys such as
# products/cotton/blue.webp. Use the bucket's public custom domain or r2.dev URL,
# never the S3-compatible cloudflarestorage.com endpoint.
VITE_R2_PUBLIC_URL=

VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
VITE_SITE_NAME=Hamza Fabrics
VITE_SITE_DESCRIPTION=Premium Unstitched Fabrics
VITE_CONTACT_EMAIL=contact@hamzafabrics.com
VITE_CONTACT_PHONE=+8801700000000
VITE_ADDRESS=Dhaka, Bangladesh
VITE_CURRENCY=BDT
VITE_DELIVERY_INSIDE=80
VITE_DELIVERY_OUTSIDE=150
VITE_FREE_DELIVERY_MIN=3
